# Build-time public configuration. No secrets, tokens, or passwords go here.
SITE_URL=https://solivantstudios.com
# Keep false for development/staging. Enable only at the public launch.
SITE_INDEXABLE=false
# Published email address (e.g. contact@solivantstudios.com). Leave blank in local/staging unless testing email mode.
CONTACT_EMAIL=
# disabled | netlify. Forms only render on a Netlify production build.
CONTACT_PROVIDER=disabled
# Review privacy wording and provider settings before enabling the form.
CONTACT_PRIVACY_REVIEWED=false
