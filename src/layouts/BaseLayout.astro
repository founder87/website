---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site, settings } from "../data/site";
import "../styles/global.css";
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; }
const { title = site.name, description = site.description, image = "/brand/social.png", noindex = false } = Astro.props;
const pageTitle = title === site.name ? title : title + " | " + site.name;
const canonical = new URL(Astro.url.pathname, settings.origin);
const socialImage = new URL(image, settings.origin);
---
<!doctype html>
<html lang="en" data-ga-id={settings.gaMeasurementId || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#142b26" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || !settings.indexable ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="256x256" href="/brand/icon.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={image === "/brand/social.png" ? "Solivant Studios Sun Moth logo in sage and gold on forest green." : title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script>
      const gaId = document.documentElement.dataset.gaId;
      if (gaId) {
        const w = window as Window & { dataLayer?: unknown[] };
        w.dataLayer = w.dataLayer || [];
        function gtag(...args: unknown[]) {
          w.dataLayer!.push(args);
        }
        gtag("js", new Date());
        const isGtm = gaId.startsWith("GTM-");
        if (isGtm) {
          w.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
        } else {
          gtag("config", gaId);
        }
        const script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/" + (isGtm ? "gtm.js?id=" : "gtag/js?id=") + encodeURIComponent(gaId);
        document.head.appendChild(script);
        document.addEventListener("click", event => {
          const link = event.target instanceof Element ? event.target.closest("a") : null;
          if (!link) return;
          const href = link.getAttribute("href") || "";
          const track = link.getAttribute("data-track");
          const label = (link.textContent || "").trim().replace(/\s+/g, " ").slice(0, 80);
          if (track) {
            gtag("event", track, { link_url: href, link_text: label });
          } else if (href.startsWith("mailto:")) {
            gtag("event", "contact_email_click", { link_url: href });
          } else if (href.startsWith("/projects/")) {
            gtag("event", "project_click", { project_path: href, link_text: label });
          } else if (/^https?:\/\//i.test(href)) {
            gtag("event", "outbound_click", { link_url: href, link_text: label });
          }
        });
      }
    </script>
  </body>
</html>
