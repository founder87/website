---
import BaseLayout from "../layouts/BaseLayout.astro";
import { settings } from "../data/site";
---
<BaseLayout title="Contact" description="Contact information and inquiries for Solivant Studios.">
  <header class="container page-header">
    <p class="eyebrow">Solivant Studios</p>
    <h1>Contact</h1>
    <p class="lede">Direct inquiries regarding our projects, press, and partnerships.</p>
  </header>
  <section class="container section-bottom contact-layout" aria-labelledby="inquiries-title">
    <div>
      <h2 id="inquiries-title">Inquiries</h2>
      {settings.contactEmail ? <p class="body-copy">For press, publishing, or studio correspondence, reach us directly at <a class="text-link contact-email" href={"mailto:" + encodeURIComponent(settings.contactEmail)}>{settings.contactEmail}</a>.</p> : <p class="body-copy">Our public contact channel is being prepared. Please check back here for the studio’s contact details.</p>}
    </div>
    {settings.contactEnabled ? (
      <form class="contact-form" name="studio-inquiry" method="POST" action="/contact/success/" data-netlify="true" netlify-honeypot="company-site">
        <input type="hidden" name="form-name" value="studio-inquiry" />
        <p class="form-honeypot" aria-hidden="true"><label>Leave this field empty<input name="company-site" tabindex="-1" autocomplete="off" /></label></p>
        <p class="small muted" id="form-help">All fields are required. Please don’t include passwords, payment details, or confidential material.</p>
        <div class="form-row">
          <label for="contact-name">Name<input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required /></label>
          <label for="contact-email">Email<input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></label>
        </div>
        <label for="contact-subject">Subject<select id="contact-subject" name="subject" required><option value="">Choose a subject</option><option value="general">General inquiry</option><option value="press">Press and media</option><option value="business">Business inquiry</option><option value="project">Project question</option></select></label>
        <label for="contact-message">Message<textarea id="contact-message" name="message" rows="7" minlength="10" maxlength="5000" aria-describedby="form-help message-help" required></textarea></label>
        <p class="small muted" id="message-help">10–5,000 characters. Submitted through Netlify Forms. See <a href="/privacy/">site privacy</a>.</p>
        <button class="button" type="submit">Send inquiry</button>
      </form>
    ) : settings.contactEmail ? (
      <div class="inquiry-channels">
        <div>
          <p class="eyebrow">Player support</p>
          <p class="small muted">Need technical assistance or troubleshooting for a Solivant Studios title on iOS or Steam?</p>
          <div class="actions">
            <a class="text-link" href="/support/">Player Support →</a>
          </div>
        </div>
        <div>
          <p class="eyebrow">Initial release</p>
          <p class="small muted">Read the overview and current development status for Byzantium.</p>
          <div class="actions">
            <a class="text-link" href="/projects/byzantium/">Explore Byzantium →</a>
          </div>
        </div>
      </div>
    ) : (
      <div class="contact-notice">
        <span class="eyebrow">Contact status</span>
        <h3>Not open just yet.</h3>
        <p>Online inquiries aren’t enabled yet. No information is collected through a form on this page.</p>
        <a class="text-link" href="/projects/">View projects</a>
      </div>
    )}
  </section>
</BaseLayout>
