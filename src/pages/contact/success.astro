---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { settings } from "../../data/site";
---
<BaseLayout title="Contact confirmation" noindex>
  <section class="container page-header message-page">
    <p class="eyebrow">Studio inquiries</p>
    <h1>{settings.contactEnabled ? "Thank you." : "Not open just yet."}</h1>
    <p class="lede">{settings.contactEnabled ? "If you’ve just submitted the contact form, your inquiry has been sent for processing. Thanks for reaching out to Solivant Studios." : "Online inquiries aren’t enabled on this version of the site. No message has been sent from this page."}</p>
    <a class="button" href="/contact/">Back to contact <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
