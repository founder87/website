---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Studio" description="About Solivant Studios.">
  <header class="page-header section">
    <div class="container narrow">
      <p class="eyebrow">Solivant Studios</p>
      <h1>Studio</h1>
      <p class="lede">
        This page is ready for the studio story, team information, values, and location when that material is finalized.
      </p>
    </div>
  </header>

  <section class="section section--bordered" aria-labelledby="studio-content-heading">
    <div class="container narrow prose">
      <h2 id="studio-content-heading">About the studio</h2>
      <p>Final studio copy will be added here.</p>
    </div>
  </section>
</BaseLayout>
