---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMoment from "../components/BrandMoment.astro";
import { projects } from "../data/projects";
---
<BaseLayout title="The studio" description="Meet Solivant Studios, an independent game studio with four projects in development.">
  <header class="container page-header">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> The studio</p>
    <h1>We are<br /><em>Solivant.</em></h1>
    <p class="lede">An independent game studio building distinct worlds from the ground up.<br />Four projects in development, each shared at its own pace.</p>
  </header>
  <section class="container section-bottom" aria-labelledby="pillars-title">
    <div class="section-heading">
      <div><p class="eyebrow">01 / How we build</p><h2 id="pillars-title">Studio principles.</h2></div>
      <p>Focused creative direction across four original projects.</p>
    </div>
    <div class="pillar-grid">
      <div class="pillar-card">
        <p class="eyebrow">Principle 01</p>
        <h3>Original worlds</h3>
        <p>Every project starts with a distinct setting, tone, and sense of place designed to stand on its own.</p>
      </div>
      <div class="pillar-card">
        <p class="eyebrow">Principle 02</p>
        <h3>Systems with depth</h3>
        <p>We build mechanics and worlds that reward curiosity, mastery, and meaningful player choices.</p>
      </div>
      <div class="pillar-card">
        <p class="eyebrow">Principle 03</p>
        <h3>Deliberate craft</h3>
        <p>We share our work when it is ready to speak for itself—focusing on lasting quality over early noise.</p>
      </div>
    </div>
  </section>
  <section class="section studio-band" aria-labelledby="studio-projects">
    <div class="container editorial-grid">
      <div><p class="eyebrow">02 / Currently in development</p><h2 id="studio-projects">Our next<br />chapter.</h2><p class="body-copy">Every project in the Solivant slate begins with a clear identity and the space to grow before it is shown. We publish confirmed details, artwork, and milestones here as each game takes shape.</p></div>
      <div class="studio-project-list">
        {projects.map((project, index) => <a href={"/projects/" + project.slug + "/"}><span class="eyebrow">{String(index + 1).padStart(2, "0")}</span><span>{project.title}{project.workingTitle && <small>Working title</small>}</span><span aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>
  <section class="container section studio-signature" aria-labelledby="signature-title">
    <div><p class="eyebrow">03 / Our signature</p><h2 id="signature-title">The Sun Moth.</h2><p class="body-copy">The mark of Solivant Studios.<br />A quiet light at the beginning of something new.</p></div>
    <BrandMoment tone="mono" />
  </section>
</BaseLayout>
