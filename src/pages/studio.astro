---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Studio" description="Solivant Studios. Mundi sine fine. Developing Byzantium alongside upcoming codenamed projects.">
  <header class="container page-header">
    <p class="eyebrow">Solivant Studios</p>
    <h1><em>Mundi sine fine</em></h1>
  </header>

  <section class="container section-bottom editorial-grid" aria-labelledby="studio-overview">
    <div>
      <p class="eyebrow">Overview</p>
      <h2 id="studio-overview">The studio</h2>
    </div>
    <div>
      <p class="lede">Solivant Studios builds strategy and simulation games designed for depth, historical weight, and physical realism.</p>
      <p class="body-copy">Our current production focus is our initial release, <strong>Byzantium</strong>, set in the Eastern Roman Empire around the year 1000. Alongside Byzantium, the studio is developing upcoming projects under the codenames <strong>Cubes</strong>, <strong>Hexagonal</strong>, and <strong>Horizon</strong>.</p>
      <div class="actions">
        <a class="button button--gold" href="/projects/byzantium/">Explore Byzantium</a>
        <a class="button button--outline" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
