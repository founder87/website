---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectArtwork from "../../components/ProjectArtwork.astro";
import { projects, type Project } from "../../data/projects";
export function getStaticPaths() {
  return projects.filter(p => !p.workingTitle).map(project => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project; }
const { project } = Astro.props;
const isByzantium = project.slug === "byzantium";
---
<BaseLayout title={project.title} description={project.summary} image={project.cover?.src} pageTone={project.tone}>
  <div class="container project-header">
    <a class="back-link" href="/projects/"><span aria-hidden="true">←</span> All projects</a>
  </div>
  <div class="container">
    {project.cover ? (
      <>
        <header class="project-header__title">
          <div>
            <p class="eyebrow">Initial Release</p>
            <h1>{project.title}</h1>
          </div>
          <span class="working-title">{project.status}</span>
        </header>
        <figure class="project-cover">
          <img src={project.cover.src} alt={project.cover.alt} width={project.cover.width} height={project.cover.height} fetchpriority="high" />
          {project.cover.caption && <figcaption>{project.cover.caption}</figcaption>}
        </figure>
      </>
    ) : (
      <header class="project-title-panel" data-tone={project.tone}>
        <ProjectArtwork slug={project.slug} tone={project.tone} />
        {isByzantium && <div class="flagship-stage__horizon" aria-hidden="true"></div>}
        <div class="project-title-panel__top">
          <span class="project-title-panel__index">{isByzantium ? "Anno Domini 1000 · Constantinople" : "Initial release"}</span>
          <span class="project-title-panel__status">{project.status}</span>
        </div>
        <h1 class="project-title-panel__name">{project.title}</h1>
        <p>Solivant Studios <span>Preview forthcoming</span></p>
      </header>
    )}
  </div>
  <section class="container section project-overview" aria-labelledby="about-project">
    <div>
      <p class="eyebrow">Circa 1000 AD · Eastern Roman Empire</p>
      <h2 id="about-project">For Byzantium</h2>
      {project.description.map(paragraph => <p class="body-copy">{paragraph}</p>)}
      <div class="actions">
        {project.trailer && <a class="button button--gold" href={project.trailer.href} rel="noopener noreferrer">{project.trailer.label}</a>}
        {project.links?.map(link => <a class="button button--outline" href={link.href} rel="noopener noreferrer">{link.label}</a>)}
        <a class="text-link" href="/contact/">Inquire about {project.title}</a>
      </div>
    </div>
    <dl class="project-facts">
      <div><dt>Studio</dt><dd>Solivant Studios</dd></div>
      <div><dt>Status</dt><dd>{project.status}</dd></div>
      <div><dt>Release</dt><dd>Initial release</dd></div>
      <div><dt>Setting</dt><dd>Constantinople &amp; the Byzantine World (c. 1000 AD)</dd></div>
      <div><dt>Technology</dt><dd>Hyperoptimized custom engine built for physical realism and broad device reach</dd></div>
    </dl>
  </section>
  {project.gallery?.length && (
    <section class="container section-bottom" aria-labelledby="gallery-title">
      <div class="section-heading"><div><p class="eyebrow">Media</p><h2 id="gallery-title">Gallery</h2></div></div>
      <div class="gallery">{project.gallery.map(image => <figure><a href={image.src} aria-label={"View full-size image: " + image.alt}><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></a>{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div>
    </section>
  )}
</BaseLayout>
