---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, type Project } from "../../data/projects";
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } })); }
interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length]!;
---
<BaseLayout title={project.title} description={project.summary} image={project.cover?.src}>
  <header class="container page-header project-header">
    <a class="back-link" href="/projects/"><span aria-hidden="true">←</span> All projects</a>
    <div class="project-header__title">
      <div><p class="eyebrow">Project {String(index + 1).padStart(2, "0")} / {project.status}</p><h1>{project.title}<span class="title-period">.</span></h1></div>
      {project.workingTitle && <span class="working-title">Working title</span>}
    </div>
  </header>
  <div class="container">
    {project.cover ? (
      <figure class="project-cover">
        <img src={project.cover.src} alt={project.cover.alt} width={project.cover.width} height={project.cover.height} fetchpriority="high" />
        {project.cover.caption && <figcaption>{project.cover.caption}</figcaption>}
      </figure>
    ) : (
      <div class="project-title-panel" data-tone={project.tone} aria-label="Project artwork has not been revealed">
        <span class="project-title-panel__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <span class="project-title-panel__name" aria-hidden="true">{project.title}</span>
        <p>Solivant Studios <span>Artwork to be revealed</span></p>
      </div>
    )}
  </div>
  <section class="container section project-overview" aria-labelledby="about-project">
    <div><p class="eyebrow">About the project</p><h2 id="about-project">Taking shape.</h2>{project.description.map(paragraph => <p class="body-copy">{paragraph}</p>)}
      {(project.links?.length || project.trailer) && <div class="actions">
        {project.trailer && <a class="button" href={project.trailer.href} rel="noopener noreferrer">{project.trailer.label} <span aria-hidden="true">↗</span></a>}
        {project.links?.map(link => <a class="button button--outline" href={link.href} rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}
      </div>}
    </div>
    <dl class="project-facts">
      <div><dt>Studio</dt><dd>Solivant Studios</dd></div>
      <div><dt>Status</dt><dd>{project.status}</dd></div>
      {project.workingTitle && <div><dt>Title</dt><dd>Working title</dd></div>}
      <div><dt>Platforms</dt><dd>{project.platforms.length ? project.platforms.join(", ") : "To be announced"}</dd></div>
      <div><dt>Release</dt><dd>{project.release || "To be announced"}</dd></div>
    </dl>
  </section>
  {project.gallery?.length && (
    <section class="container section-bottom" aria-labelledby="gallery-title">
      <div class="section-heading"><div><p class="eyebrow">A closer look</p><h2 id="gallery-title">From the game.</h2></div></div>
      <div class="gallery">{project.gallery.map(image => <figure><a href={image.src} aria-label={"View full-size image: " + image.alt}><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></a>{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div>
    </section>
  )}
  <section class="next-project section--bordered">
    <a class="container next-project__link" href={"/projects/" + next.slug + "/"}><div><p class="eyebrow">Next project</p><h2>{next.title}</h2></div><span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
