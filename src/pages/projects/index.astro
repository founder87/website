---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="Projects" description="Explore the four projects in development at Solivant Studios, led by our initial release Byzantium alongside BoomTown, The Grid, and Horizon.">
  <header class="container page-header">
    <p class="eyebrow">The Solivant collection / 01—04</p>
    <h1>In the <em>making.</em></h1>
    <p class="lede">Led by our flagship initial release, Byzantium. Explore all four worlds currently in development at Solivant Studios.</p>
  </header>
  <section class="container section-bottom" aria-label="All projects">
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    <p class="project-index-note">Byzantium is our initial release in active development. BoomTown, The Grid, and Horizon are codenames for upcoming projects with limited public information. Target platforms and release dates will be shared as they are announced.</p>
  </section>
</BaseLayout>
