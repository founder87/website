---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="Projects" description="Games in development at Solivant Studios, led by our initial release Byzantium alongside upcoming codenamed projects Cubes, Hexagonal, and Horizon.">
  <header class="container page-header">
    <p class="eyebrow">Projects</p>
    <h1>In development</h1>
    <p class="lede">Led by our initial release, Byzantium, alongside upcoming codenamed projects.</p>
  </header>
  <section class="container section-bottom" aria-label="All projects">
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </section>
</BaseLayout>
