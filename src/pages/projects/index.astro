---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectArtwork from "../../components/ProjectArtwork.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
const flagship = projects[0]!;
const upcoming = projects.slice(1);
---
<BaseLayout title="Projects" description="Games in development at Solivant Studios, led by our initial release Byzantium alongside upcoming codenamed projects Hexagonal, Cubes, and Horizon.">
  <header class="container page-header">
    <p class="eyebrow">Projects</p>
    <h1>In development</h1>
  </header>
  <section class="container section-bottom" aria-label="All projects">
    <article class="project-card flagship-spotlight" data-tone={flagship.tone}>
      <a class="flagship-spotlight__visual" href="/projects/byzantium/" aria-label="Explore Byzantium">
        <ProjectArtwork slug={flagship.slug} tone={flagship.tone} />
        <div class="flagship-stage__horizon" aria-hidden="true"></div>
        <div class="project-card__hud-top" aria-hidden="true">
          <span class="project-card__edition">Initial release</span>
          <span class="project-card__note">In development</span>
        </div>
        <span class="flagship-spotlight__title" aria-hidden="true">Byzantium</span>
      </a>
      <div class="flagship-spotlight__copy">
        <p class="eyebrow">Initial Release · Circa 1000 AD</p>
        <h2>For Byzantium</h2>
        <p class="body-copy">{flagship.summary}</p>
        <div class="actions">
          <a class="button button--gold" href="/projects/byzantium/" data-track="projects_byzantium">Explore Byzantium</a>
        </div>
      </div>
    </article>

    <div class="upcoming-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Upcoming</p>
          <h2>Codenamed projects</h2>
        </div>
      </div>
      <div class="project-grid project-grid--upcoming">
        {upcoming.map((project, index) => <ProjectCard project={project} index={index + 1} heading="h3" />)}
      </div>
    </div>
  </section>
</BaseLayout>
