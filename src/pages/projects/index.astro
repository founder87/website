---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="Projects" description="Explore the four projects in development at Solivant Studios: BoomTown, The Grid, Horizon, and Bastion.">
  <header class="container page-header">
    <p class="eyebrow">The Solivant collection / 01—04</p>
    <h1>In the <em>making.</em></h1>
    <p class="lede">Explore our projects. More artwork, gameplay, and development details will be shared as they’re ready.</p>
  </header>
  <section class="container section-bottom" aria-label="All projects">
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    <p class="project-index-note">Horizon and Bastion are working titles. Platforms and release dates have not been announced.</p>
  </section>
</BaseLayout>
