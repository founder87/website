---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" noindex>
  <section class="container page-header message-page">
    <p class="eyebrow">404 · Page Not Found</p>
    <h1>Route off course</h1>
    <p class="lede">The page you requested does not exist or has moved.</p>
    <div class="actions">
      <a class="button button--gold" href="/">Return home</a>
      <a class="button button--outline" href="/projects/byzantium/">Explore Byzantium</a>
      <a class="text-link" href="/support/">Player Support</a>
    </div>
  </section>
</BaseLayout>
