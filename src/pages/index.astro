---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMoment from "../components/BrandMoment.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---
<BaseLayout>
  <section class="hero container" aria-labelledby="home-title">
    <div class="hero__copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Independent game studio</p>
      <h1 id="home-title">New worlds.<br /><em>Taking shape.</em></h1>
      <p class="lede">Four projects in the making.<br />This is where their stories begin.</p>
      <a href="#projects" class="button">Explore our projects <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero__identity">
      <BrandMoment eager />
      <p class="hero__aside">Solivant Studios <span>Games in development</span></p>
    </div>
  </section>
  <section id="projects" class="section section--bordered" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">01 / Our projects</p><h2 id="projects-title">From the studio.</h2></div>
        <p>Four projects. One studio.<br />Discover what’s taking shape.</p>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} heading="h3" />)}
      </div>
    </div>
  </section>
  <section class="section studio-band" aria-labelledby="studio-title">
    <div class="container editorial-grid">
      <p class="eyebrow">02 / Solivant Studios</p>
      <div>
        <h2 id="studio-title">A place for<br /><em>new possibilities.</em></h2>
        <p class="lede">We’re an independent game studio developing BoomTown, The Grid, Horizon, and Bastion. Follow each project here as we share more.</p>
        <a class="text-link" href="/studio/">Meet the studio <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
