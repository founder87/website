---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectArtwork from "../components/ProjectArtwork.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
const flagship = projects[0]!;
---
<BaseLayout>
  <section class="hero container" aria-labelledby="home-title">
    <div class="hero__copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Solivant Studios // Initial release: Byzantium</p>
      <h1 id="home-title">New worlds.<br /><em>Taking shape.</em></h1>
      <p class="lede">We are an independent studio engineering hyperoptimized game engines that push hardware to its limits—combining grounded physical realism with wider access across devices. Led by our initial release, <strong>Byzantium</strong>.</p>
      <div class="actions">
        <a href="/projects/byzantium/" class="button">Explore Byzantium <span aria-hidden="true">↗</span></a>
        <a href="#projects" class="button button--outline">Upcoming slate <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero__slate" aria-label="Development slate">
      {projects.map((project, index) => (
        <a class="hero__slate-item" href={"/projects/" + project.slug + "/"} data-tone={project.tone}>
          <span class="eyebrow">0{index + 1}{index === 0 ? " · Initial release" : " · Codename"}</span>
          <strong>{project.title}</strong>
          <small>{project.workingTitle ? "Upcoming · Limited info" : "In active development"}</small>
        </a>
      ))}
    </div>
  </section>
  <section class="section section--bordered" aria-labelledby="flagship-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">01 / Flagship initial release</p><h2 id="flagship-title">Byzantium.</h2></div>
        <p>Fortress architecture, siegecraft, and<br />formation warfare in the Byzantine world.</p>
      </div>
      <div class="flagship-spotlight" data-tone={flagship.tone}>
        <a class="flagship-spotlight__visual" href="/projects/byzantium/" aria-label="Explore Byzantium project dossier">
          <ProjectArtwork slug={flagship.slug} tone={flagship.tone} />
          <div class="project-card__hud-top" aria-hidden="true">
            <span class="project-card__edition">SOLIVANT // DEBUT RELEASE</span>
            <span class="project-card__badge">Primary focus</span>
          </div>
          <span class="flagship-spotlight__title" aria-hidden="true">Byzantium</span>
          <div class="project-card__hud-bottom" aria-hidden="true">
            <span class="project-card__note"><span class="status-dot"></span>In active development</span>
            <span class="project-card__enter">Open project dossier ↗</span>
          </div>
        </a>
        <div class="flagship-spotlight__copy">
          <p class="eyebrow">World & systems overview</p>
          <h3>Raise the walls.<br />Hold the line.</h3>
          <p class="body-copy">Byzantium is the first release in development at Solivant Studios—combining grounded timber and masonry castle construction with siege engineering and disciplined close-order battlefield clashes.</p>
          <dl class="flagship-pillars">
            <div><dt>01 / Fortress architecture</dt><dd>Construct layered palisades, watchtowers, gatehouses, and stone citadels shaped by terrain.</dd></div>
            <div><dt>02 / Siegecraft & defense</dt><dd>Deploy rams, siege towers, and artillery—or engineer fortifications built to withstand them.</dd></div>
            <div><dt>03 / Formation warfare</dt><dd>Command shield walls and shock units where spacing, momentum, and line cohesion matter.</dd></div>
          </dl>
          <div class="actions">
            <a class="button" href="/projects/byzantium/">View Byzantium dossier <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section id="projects" class="section section--bordered" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">02 / Initial release & upcoming codenames</p><h2 id="projects-title">From the studio.</h2></div>
        <p>Byzantium leads our production slate.<br />BoomTown, The Grid, and Horizon are upcoming codenamed projects.</p>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} heading="h3" />)}
      </div>
    </div>
  </section>
  <section class="section studio-band" aria-labelledby="studio-title">
    <div class="container">
      <div class="editorial-grid">
        <p class="eyebrow">03 / Solivant Studios</p>
        <div>
          <h2 id="studio-title">Engineered for<br /><em>scale & realism.</em></h2>
          <p class="lede">At Solivant Studios, we focus on hyperoptimizing game engines to push devices to their limits—unlocking grounded physical realism and large-scale simulation while increasing access across hardware.</p>
          <div class="actions">
            <a class="button button--outline" href="/studio/">Inside the studio <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="/contact/">Studio inquiries <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
      <div class="pillar-grid">
        <div class="pillar-card">
          <p class="eyebrow">01 / Engine performance</p>
          <h3>Hyperoptimized to the metal</h3>
          <p>We engineer low-level systems that extract maximum throughput from modern hardware, pushing devices to their true limits without wasted overhead.</p>
        </div>
        <div class="pillar-card">
          <p class="eyebrow">02 / Accessibility</p>
          <h3>Wider access to ambitious games</h3>
          <p>Extreme optimization means demanding simulations and rich worlds run smoothly across a broader spectrum of player hardware.</p>
        </div>
        <div class="pillar-card">
          <p class="eyebrow">03 / Simulation</p>
          <h3>Grounded physical realism</h3>
          <p>From structural masonry and siege ballistics to dense unit formations, our worlds are built on physically plausible systems with weight and consequence.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
