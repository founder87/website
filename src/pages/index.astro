---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
const flagship = projects[0]!;
const upcoming = projects.slice(1);
---
<BaseLayout>
  <section class="hero container" aria-labelledby="home-title">
    <div class="hero__copy">
      <p class="eyebrow">Solivant Studios</p>
      <h1 id="home-title"><em>Mundi sine fine</em></h1>
      <p class="lede">We build hyperoptimized game engines that push hardware to its limits—combining grounded physical realism with wider access across devices. Our initial release in development is <strong>Byzantium</strong>.</p>
      <div class="actions">
        <a href="/projects/byzantium/" class="button">Byzantium</a>
        <a href="/studio/" class="button button--outline">The studio</a>
      </div>
    </div>
  </section>
  <section id="projects" class="section section--bordered" aria-labelledby="flagship-title">
    <div class="container">
      <article class="project-card project-card--flagship flagship-spotlight" data-tone={flagship.tone}>
        <a class="flagship-spotlight__visual" href="/projects/byzantium/" aria-label="View Byzantium">
          <div class="project-card__hud-top" aria-hidden="true">
            <span class="project-card__edition">Initial release</span>
            <span class="project-card__note">In development</span>
          </div>
          <span class="flagship-spotlight__title" aria-hidden="true">Byzantium</span>
        </a>
        <div class="flagship-spotlight__copy">
          <p class="eyebrow">Initial release · Circa 1000 AD</p>
          <h2 id="flagship-title">For Byzantium</h2>
          <p class="body-copy">Around the year 1000, Constantinople is the greatest city in the Christian world, but the Roman Empire is a shadow of its former self. Engulfed in internal struggle and looming threats from outside, the emperor himself has called upon you to serve. For Byzantium.</p>
          <p class="body-copy">Raise timber and stone fortifications, engineer siege weapons, and command disciplined battlefield formations across the Byzantine world.</p>
          <div class="actions">
            <a class="button" href="/projects/byzantium/">Explore Byzantium</a>
          </div>
        </div>
      </article>
      <div class="upcoming-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Upcoming</p>
            <h2>Codenamed projects</h2>
          </div>
          <p>Limited information is available while development focuses on Byzantium.</p>
        </div>
        <div class="project-grid project-grid--upcoming">
          {upcoming.map((project, index) => <ProjectCard project={project} index={index + 1} heading="h3" />)}
        </div>
      </div>
    </div>
  </section>
  <section class="section studio-band" aria-labelledby="studio-title">
    <div class="container editorial-grid">
      <p class="eyebrow">Solivant Studios</p>
      <div>
        <h2 id="studio-title">Realism through engineering</h2>
        <p class="lede">We focus on low-level engine optimization to push devices to their limits—making large-scale simulation and physical realism run smoothly across a broader range of hardware.</p>
        <div class="actions">
          <a class="button button--outline" href="/studio/">About the studio</a>
          <a class="text-link" href="/contact/">Contact</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
