---
interface Props {
  class?: string;
  animated?: boolean;
  compact?: boolean;
}

const {
  class: className = "",
  animated = false,
  compact = false,
} = Astro.props;

const titleId = `solivant-logo-title-${compact ? "compact" : "full"}`;
---

<svg
  class:list={["studio-logo", className, { "studio-logo--animated": animated }]}
  viewBox={compact ? "0 0 300 100" : "0 0 300 156"}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby={titleId}
>
  <title id={titleId}>Solivant Studios</title>
  <path
    class="studio-logo__pulse"
    pathLength="100"
    fill="none"
    stroke="currentColor"
    stroke-width="8.1"
    stroke-linecap="round"
    stroke-linejoin="round"
    d="M8.1 85.9L68.4 85.3L80.8 84.4L87.9 83.3L93.2 82.1L96.8 81.0L100.3 79.6L103.9 77.8L105.6 76.8L107.4 75.6L109.2 74.3L111.0 72.9L112.7 71.3L114.5 69.5L116.3 67.6L118.1 65.5L119.8 63.2L121.6 60.7L123.4 58.1L125.2 55.3L128.7 49.3L135.8 36.6L137.6 33.7L139.4 30.9L141.1 28.4L142.9 26.2L144.7 24.4L146.5 23.1L148.2 22.3L150.0 22.1L151.8 22.3L153.5 23.1L155.3 24.4L157.1 26.2L158.9 28.4L160.6 30.9L162.4 33.7L164.2 36.6L171.3 49.3L174.8 55.3L176.6 58.1L178.4 60.7L180.2 63.2L181.9 65.5L183.7 67.6L185.5 69.5L187.3 71.3L189.0 72.9L190.8 74.3L192.6 75.6L194.4 76.8L197.9 78.7L201.5 80.3L205.0 81.6L210.3 82.9L217.4 84.1L233.4 85.4L291.9 85.9"
  />
  {!compact && (
    <text
      class="studio-logo__word"
      x="150"
      y="150"
      text-anchor="middle"
      fill="currentColor"
      font-family="Arial, Helvetica, sans-serif"
      font-size="32"
      font-weight="600"
      letter-spacing="-0.5"
    >
      solivant
    </text>
  )}
</svg>

<style>
  .studio-logo {
    display: block;
    height: auto;
    overflow: visible;
  }

  .studio-logo--animated .studio-logo__pulse {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw-pulse 900ms cubic-bezier(0.33, 0, 0.15, 1) 150ms forwards;
  }

  .studio-logo--animated .studio-logo__word {
    opacity: 0;
    animation: reveal-word 450ms ease 720ms forwards;
  }

  @keyframes draw-pulse {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes reveal-word {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-logo--animated .studio-logo__pulse,
    .studio-logo--animated .studio-logo__word {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }
</style>
