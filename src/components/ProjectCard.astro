---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <a class="project-card__link" href={`/projects/${project.slug}/`}>
    <div class="project-card__media" aria-hidden="true">
      {project.heroImage ? (
        <img src={project.heroImage} alt="" loading="lazy" />
      ) : (
        <span>Artwork forthcoming</span>
      )}
    </div>
    <div class="project-card__body">
      <p class="eyebrow">{project.status} · Working title</p>
      <h2>{project.publicTitle}</h2>
      <p>{project.summary}</p>
      <span class="text-link">View project <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>
