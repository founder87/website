---
import type { Project } from "../data/projects";
import ProjectArtwork from "./ProjectArtwork.astro";
interface Props { project: Project; heading?: "h2" | "h3"; }
const { project, heading: Heading = "h2" } = Astro.props;
---
<article class="project-card" data-tone={project.tone}>
  <div class="project-card__visual">
    <div class="project-card__type">
      <ProjectArtwork slug={project.slug} tone={project.tone} />
      <div class="project-card__hud-top">
        <span class="project-card__edition">Codename</span>
        <span class="project-card__note">{project.status}</span>
      </div>
      <Heading class="project-card__display">{project.title}</Heading>
    </div>
  </div>
</article>
