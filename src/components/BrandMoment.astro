---
interface Props { tone?: "verdant" | "mono"; eager?: boolean; }
const { tone = "verdant", eager = false } = Astro.props;
const poster = "/brand/poster-" + tone + ".webp";
---
<figure class:list={["brand-moment", "brand-moment--" + tone]} data-brand-moment data-poster={poster} data-motion={"/brand/sunrise-" + tone + ".gif"}>
  <div class="brand-moment__screen">
    <img src={poster} width="1200" height="675" alt="Solivant Studios Sun Moth logo"
      loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding="async" />
  </div>
  <figcaption class="brand-moment__caption">
    <span>Sun Moth <span class="muted">/ Sunrise</span></span>
    <button class="motion-button" type="button" hidden aria-label="Play the six-second silent studio animation">
      <span data-motion-label>Play ident</span> <span aria-hidden="true">↗</span>
    </button>
    <span class="sr-only" role="status" data-motion-status></span>
  </figcaption>
</figure>
<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  document.querySelectorAll<HTMLElement>("[data-brand-moment]").forEach(figure => {
    const img = figure.querySelector<HTMLImageElement>("img");
    const button = figure.querySelector<HTMLButtonElement>("button");
    const label = figure.querySelector<HTMLElement>("[data-motion-label]");
    const status = figure.querySelector<HTMLElement>("[data-motion-status]");
    if (!img || !button || !label || !status) return;
    let playing = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const stop = () => {
      clearTimeout(timer);
      img.onload = null;
      img.onerror = null;
      img.src = figure.dataset.poster!;
      playing = false;
      label.textContent = "Play ident";
      button.setAttribute("aria-label", "Play the six-second silent studio animation");
      status.textContent = "Still logo.";
    };
    const syncPreference = () => { stop(); button.hidden = reduceMotion.matches; };
    button.addEventListener("click", () => {
      if (playing) { stop(); return; }
      if (reduceMotion.matches) return;
      playing = true;
      label.textContent = "Stop ident";
      button.setAttribute("aria-label", "Stop the studio animation");
      status.textContent = "Playing six-second silent animation.";
      img.onload = () => { timer = setTimeout(stop, 5950); };
      img.onerror = () => { stop(); status.textContent = "Animation unavailable. Showing the still logo."; };
      img.src = figure.dataset.motion + "?play=" + Date.now();
    });
    document.addEventListener("visibilitychange", () => { if (document.hidden && playing) stop(); });
    reduceMotion.addEventListener("change", syncPreference);
    syncPreference();
  });
</script>
