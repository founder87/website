---
import StudioLogo from "./StudioLogo.astro";
import { site } from "../data/site";
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Solivant Studios home"><StudioLogo compact /></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" hidden>
      <span data-menu-label>Menu</span><span aria-hidden="true" class="menu-toggle__icon">+</span>
    </button>
    <nav id="primary-navigation" aria-label="Main navigation">
      <ul class="site-header__nav">
        {site.navigation.map(link => (
          <li><a href={link.href} aria-current={currentPath.startsWith(link.href) ? "page" : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = header?.querySelector<HTMLElement>("nav");
  if (header && toggle && navigation) {
    const mobile = window.matchMedia("(max-width: 42rem)");
    function setOpen(open: boolean, restoreFocus = false) {
      if (!toggle || !header) return;
      toggle.setAttribute("aria-expanded", String(open));
      header.dataset.menuOpen = String(open);
      const label = toggle.querySelector("[data-menu-label]");
      if (label) label.textContent = open ? "Close" : "Menu";
      if (restoreFocus) toggle.focus();
    }
    header.dataset.enhanced = "true";
    toggle.hidden = false;
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") setOpen(false, true);
    });
    document.addEventListener("click", event => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    navigation.addEventListener("click", event => {
      if (event.target instanceof Element && event.target.closest("a")) setOpen(false);
    });
    mobile.addEventListener("change", () => setOpen(false));
  }
</script>
