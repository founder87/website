---
import SocialLinks from "./SocialLinks.astro";
import StudioLogo from "./StudioLogo.astro";
import { site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a href="/" class="footer-wordmark" aria-label="Solivant Studios home"><StudioLogo compact /></a>
      <p><em>{site.motto}</em></p>
      <div class="footer-links">
        <nav aria-label="Footer navigation">
          {site.navigation.map(link => <a href={link.href}>{link.label}</a>)}
        </nav>
        <SocialLinks variant="icons" />
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} Solivant Studios</p>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/terms/">Terms &amp; EULA</a>
      <a href="/support/">Support</a>
      <a href="#main-content">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
