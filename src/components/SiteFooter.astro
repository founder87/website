---
import { site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a href="/" class="footer-wordmark" aria-label="Solivant Studios home"><img src="/brand/poster-mono.webp" width="1200" height="675" alt="Solivant Studios" loading="lazy" decoding="async" /></a>
      <p><em>{site.motto}.</em><br />Independent games. New worlds in the making.</p>
      <nav aria-label="Footer navigation">
        {site.navigation.map(link => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {year} Solivant Studios</p>
      <a href="/privacy/">Site privacy</a>
      <a href="#main-content">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
