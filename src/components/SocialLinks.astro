---
import { site, type SocialLink } from "../data/site";

interface Props {
  links?: readonly SocialLink[];
  variant?: "icons" | "list";
}

const { links = site.socials, variant = "icons" } = Astro.props;
---
{links.length > 0 && (
  <ul class={"social-links social-links--" + variant} aria-label="Official social channels">
    {links.map(item => (
      <li>
        <a
          class="social-link"
          href={item.href}
          rel="noopener noreferrer me"
          aria-label={variant === "icons" ? `${site.name} on ${item.label}` : undefined}
          data-track={"social_" + item.platform}
        >
          <svg class="social-link__icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
