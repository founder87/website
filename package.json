{
  "name": "solivant-studios-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/verify-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:standalone": "npm run build && node scripts/export-standalone.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test tests/*.test.mjs",
    "test:build-modes": "node scripts/test-build-modes.mjs",
    "test:browser": "playwright test",
    "verify": "npm run test && npm run check && npm run build",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "brand:export": "node scripts/export-brand.mjs",
    "hq:setup": "node hq/scripts/setup-credentials.mjs",
    "hq:dev": "node hq/scripts/dev-server.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "engines": { "node": ">=22.12.0" }
}
